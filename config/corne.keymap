#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41 36 37 38>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        H2S: H2S {
            compatible = "zmk,behavior-hold-tap";
            label = "H2S";
            bindings = <&to>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 40 41>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        MAIN {
            display-name = "MAIN";
            bindings = <
&kp ESCAPE  &kp Q  &kp W  &kp E  &kp R  &kp T             &kp Y      &kp U    &kp I         &kp O    &kp P          &kp MINUS
&kp TAB     &kp A  &kp S  &kp D  &kp F  &kp G             &kp H      &kp J    &kp K         &kp L    &kp SEMICOLON  &kp SQT
&kp LCTRL   &kp Z  &kp X  &kp C  &kp V  &kp B             &kp N      &kp M    &kp COMMA     &kp DOT  &kp FSLH       &kp BACKSLASH
                          &mo 1  &mo 2  &kp LEFT_SHIFT    &kp SPACE  &kp RET  &kp LEFT_GUI
            >;
        };

        NUMPAD {
            bindings = <
&none  &none  &none  &none  &none           &none             &kp EQUAL      &kp NUMBER_7  &kp NUMBER_8   &kp NUMBER_9  &kp LEFT_BRACE        &kp RIGHT_BRACE
&none  &none  &none  &none  &kp LEFT_SHIFT  &none             &kp GRAVE      &kp NUMBER_4  &kp NUMBER_5   &kp NUMBER_6  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&none  &none  &none  &none  &none           &none             &kp NUMBER_0   &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3  &kp LEFT_BRACKET      &kp RIGHT_BRACKET
                     &none  &none           &kp LEFT_SHIFT    &kp BACKSPACE  &none         &kp RIGHT_ALT
            >;

            label = "NUMPAD";
        };

        FUNC {
            bindings = <
&none           &kp F1   &kp F2   &kp F3  &kp F4  &kp F5     &kp RIGHT_ALT  &kp HOME  &kp UP_ARROW  &kp END    &kp PAGE_UP    &bt BT_CLR_ALL
&kp LEFT_SHIFT  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10    &none          &kp LEFT  &kp DOWN      &kp RIGHT  &kp PAGE_DOWN  &none
&kp LEFT_ALT    &kp F11  &kp F12  &none   &none   &none      &kp DELETE     &none     &none         &none      &none          &none
                                  &none   &none   &none      &kp BACKSPACE  &none     &mo 3
            >;

            label = "FUNC";
        };

        BT {
            bindings = <
&bt BT_CLR_ALL  &none  &none  &none  &none  &none    &none         &none         &none         &none         &none         &bt BT_CLR
&none           &none  &none  &none  &none  &none    &none         &none         &none         &none         &none         &none
&none           &none  &none  &none  &none  &none    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none
                              &none  &none  &none    &none         &none         &none
            >;

            label = "BT";
        };
    };
};
