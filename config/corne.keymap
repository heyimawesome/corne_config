#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41>;
            tapping-term-ms = <280>;
            flavor = "hold-preferred";
            hold-trigger-on-release;
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "hold-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41 36 37 38>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemack {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "colemak";
            bindings = <
&kp ESCAPE  &kp Q            &kp W            &kp F                &kp P              &kp B    &kp J      &kp L               &kp U                 &kp Y             &kp SEMI          &kp MINUS
&kp TAB     &HML LEFT_GUI A  &HML LEFT_ALT R  &HML LEFT_CONTROL S  &HML LEFT_SHIFT T  &kp G    &kp M      &HMR RIGHT_SHIFT N  &HMR RIGHT_CONTROL E  &HMR RIGHT_ALT I  &HMR RIGHT_GUI O  &kp SQT
&to 1       &kp Z            &kp X            &kp C                &kp D              &kp V    &kp K      &kp H               &kp COMMA             &kp DOT           &kp FSLH          &kp BACKSLASH
                                              &mo 2                &mo 3              &none    &kp SPACE  &kp RET             &mo 3
            >;
        };

        qwerty {
            display-name = "qwerty";
            bindings = <
&kp ESCAPE  &kp Q            &kp W            &kp E                &kp R              &kp T    &kp Y      &kp U               &kp I                 &kp O             &kp P                &kp MINUS
&kp TAB     &HML LEFT_GUI A  &HML LEFT_ALT S  &HML LEFT_CONTROL D  &HML LEFT_SHIFT F  &kp G    &kp H      &HMR RIGHT_SHIFT J  &HMR RIGHT_CONTROL K  &HMR RIGHT_ALT L  &HMR RIGHT_GUI SEMI  &kp SQT
&to 0       &kp Z            &kp X            &kp C                &kp V              &kp B    &kp N      &kp M               &kp COMMA             &kp DOT           &kp FSLH             &kp BACKSLASH
                                              &mo 2                &mo 3              &none    &kp SPACE  &kp RET             &mo 3
            >;
        };

        layer_2 {
            bindings = <
&none  &none  &none         &none  &none           &none    &none         &kp NUMBER_7       &kp NUMBER_8     &kp NUMBER_9  &none  &none
&none  &none  &kp LEFT_ALT  &none  &kp LEFT_SHIFT  &none    &none         &kp NUMBER_4       &kp NUMBER_5     &kp NUMBER_6  &none  &none
&none  &none  &none         &none  &none           &none    &kp NUMBER_0  &mt EXCL NUMBER_1  &mt AT NUMBER_2  &kp NUMBER_3  &none  &none
                            &none  &none           &none    &none         &none              &none
            >;
        };

        layer_1 {
            bindings = <
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp F6     &none          &none     &kp UP_ARROW  &none      &none  &bt BT_CLR_ALL
&kp F7        &kp F8        &kp F9        &kp F10       &kp F11       &kp F12    &none          &kp LEFT  &kp DOWN      &kp RIGHT  &none  &bt BT_CLR
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none      &none          &none     &none         &none      &none  &none
                                          &none         &none         &none      &kp BACKSPACE  &none     &none
            >;
        };
    };
};
