#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <41 40 39 38 37 36 5 17 29 0 1 2 3 4 12 13 14 15 16 24 25 26 27 28 36>;
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <36 37 38 39 40 41 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 40 41>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp ESCAPE  &kp Q            &kp W            &kp F         &kp P         &kp B     &kp J      &kp L               &kp U         &kp Y             &kp SEMI         &kp MINUS
&kp TAB     &HML LEFT_GUI A  &HML LEFT_ALT R  &HML LCTRL S  &HML LSHFT T  &kp G     &kp M      &HMR RIGHT_SHIFT N  &HMR RCTRL E  &HMR RIGHT_ALT I  &HMR LEFT_GUI O  &kp SQT
&kp LCTRL   &kp Z            &kp X            &kp C         &kp D         &kp V     &kp K      &kp H               &kp COMMA     &kp DOT           &kp FSLH         &kp BACKSLASH
                                              &mo 2         &mo 1         &trans    &kp SPACE  &kp RET             &trans
            >;
        };

        layer_1 {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6     &trans         &trans    &kp UP_ARROW  &trans     &trans  &trans
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12    &trans         &kp LEFT  &kp DOWN      &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans   &trans   &trans     &trans         &trans    &trans        &trans     &trans  &trans
                        &trans   &trans   &trans     &kp BACKSPACE  &trans    &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans        &trans  &trans          &trans    &trans        &kp NUMBER_7       &kp NUMBER_8     &kp NUMBER_9  &trans  &trans
&trans  &trans  &kp LEFT_ALT  &trans  &kp LEFT_SHIFT  &trans    &trans        &kp NUMBER_4       &kp NUMBER_5     &kp NUMBER_6  &trans  &trans
&trans  &trans  &trans        &trans  &trans          &trans    &kp NUMBER_0  &mt EXCL NUMBER_1  &mt AT NUMBER_2  &kp NUMBER_3  &trans  &trans
                              &trans  &trans          &trans    &trans        &trans             &trans
            >;
        };
    };
};
